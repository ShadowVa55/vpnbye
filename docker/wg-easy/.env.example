# Настройки docker compose для wg-easy v15.
# Скопируйте в .env:  cp .env.example .env

# UDP-порт WireGuard (его открывают в firewall)
WG_PORT=51820

# TCP-порт веб-панели (http://IP:51821)
UI_PORT=51821

# true  — панель доступна по http:// (удобно для первого запуска)
# false — только https:// (нужен reverse-proxy с TLS: Caddy, Traefik, nginx)
INSECURE=true

